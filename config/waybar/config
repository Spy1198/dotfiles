{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/cava",
    "group/audio",
    "custom/notifications",
    "network",
    "battery",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 60,
    "rewrite": {
      "brave-browser": "Brave"
    }
  },
  "clock": {
    "format": "\udb82\udd54  {:%H:%M  |  %d/%m/%Y}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>"
  },
  "cpu": {
    "format": "\udb80\udf5b  {usage}%"
  },
  "memory": {
    "format": "\udb81\ude1a  {}%"
  },
  "bluetooth": {
    "on-click-middle": "$HOME/.config/hypr/scripts/bt-profile.sh",
    "format": "\udb80\udcaf {status}",
    "format-connected": "\udb80\udcb1 {device_alias}",
    "format-off": "\udb80\udcb2 off",
    "format-disabled": "\udb80\udcb2 off",
    "tooltip-format": "{controller_alias} - {num_connections} connected",
    "on-click": "alacritty --config-file ~/.config/alacritty/neon-popup.toml --class popup-bt -e bluetui",
    "on-click-right": "bluetoothctl power toggle"
  },
  "custom/notifications": {
    "format": "{icon}",
    "format-icons": {
      "notification": "\udb80\udc9a",
      "none": "\udb80\udc9c",
      "dnd-notification": "\udb80\udc9b",
      "dnd-none": "\udb82\ude91"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "\udb80\udf6c {volume}%",
    "format-source-muted": "\udb80\udf6d muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "alacritty --config-file ~/.config/alacritty/neon-popup.toml --class popup-audio -e wiremix",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "tooltip-format": "Mic: scroll = volume, click = mute, right-click = mixer"
  },
    "custom/cava": {
        "format": "♫",
        "tooltip-format": "Audio visualizer",
        "on-click": "alacritty --config-file ~/.config/alacritty/neon-popup.toml --class popup-cava -e cava"
    },
  "pulseaudio": {
    "scroll-step": 5,
    "on-click": "alacritty --config-file ~/.config/alacritty/neon-popup.toml --class popup-audio -e wiremix --tab output",
    "format": "{icon}  {volume}%",
    "format-muted": "\udb81\udf5f  Muted",
    "format-icons": {
      "default": [
        "\udb81\udd7f",
        "\udb81\udd80",
        "\udb81\udd7e"
      ]
    }
  },
  "network": {
    "on-click": "alacritty --config-file ~/.config/alacritty/neon-popup.toml --class popup-net -e $HOME/.config/hypr/scripts/nmtui-neon.sh",
    "format-wifi": "\udb82\udd28  {signalStrength}%",
    "format-ethernet": "\udb80\ude00  Connected",
    "format-disconnected": "\udb82\udd2d  Offline"
  },
  "battery": {
    "on-click": "$HOME/.config/hypr/scripts/power-panel.py",
    "on-scroll-up": "brightnessctl -n set 5%+",
    "on-scroll-down": "brightnessctl -n set 5%-",
    "tooltip-format": "{capacity}% | click: power panel, scroll: adjust",
    "format": "{icon}  {capacity}%",
    "format-icons": [
      "\udb80\udc7a",
      "\udb80\udc7b",
      "\udb80\udc7c",
      "\udb80\udc7d",
      "\udb80\udc7e",
      "\udb80\udc80"
    ]
  },
  "tray": {
    "spacing": 8
  },
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio#mic",
      "bluetooth"
    ]
  }
}
